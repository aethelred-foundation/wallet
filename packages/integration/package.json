{
  "name": "@aethelred/wallet-integration",
  "version": "0.1.0",
  "private": true,
  "description": "End-to-end composition layer for the Aethelred moat stack. Ships (a) the AgentBudget-as-PaymentGate + reputation-as-SponsorPolicy adapters that let every upstream package consume every downstream package without bespoke glue, (b) the reference end-to-end moat demo (custody -> invoice -> intent -> reputation -> budget -> x402 -> paymaster -> audit -> notarization), and (c) the solver-trio demo proving one router + one registry serves all three intent kinds through concrete solvers.",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "aethelred-moat-demo": "./bin/aethelred-moat-demo.ts",
    "aethelred-solver-trio-demo": "./bin/aethelred-solver-trio-demo.ts",
    "aethelred-institutional-compliance-demo": "./bin/aethelred-institutional-compliance-demo.ts"
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "demo": "tsx bin/aethelred-moat-demo.ts",
    "demo:solvers": "tsx bin/aethelred-solver-trio-demo.ts",
    "demo:institutional": "tsx bin/aethelred-institutional-compliance-demo.ts"
  },
  "dependencies": {
    "@aethelred/wallet-agent-budget": "file:../agent-budget",
    "@aethelred/wallet-audit": "file:../audit",
    "@aethelred/wallet-compliance": "file:../compliance",
    "@aethelred/wallet-custody-adapters": "file:../custody-adapters",
    "@aethelred/wallet-intent-router": "file:../intent-router",
    "@aethelred/wallet-invoice": "file:../invoice",
    "@aethelred/wallet-notarization": "file:../notarization",
    "@aethelred/wallet-observability": "file:../observability",
    "@aethelred/wallet-paymaster-sponsor": "file:../paymaster-sponsor",
    "@aethelred/wallet-reputation": "file:../reputation",
    "@aethelred/wallet-smart-account": "file:../smart-account",
    "@aethelred/wallet-swap-solver": "file:../swap-solver",
    "@aethelred/wallet-swap-venue-uniswap-v3": "file:../swap-venue-uniswap-v3",
    "@aethelred/wallet-transfer-solver": "file:../transfer-solver",
    "@aethelred/wallet-x402": "file:../x402",
    "@aethelred/wallet-x402-solver": "file:../x402-solver",
    "@noble/hashes": "^2.2.0"
  },
  "devDependencies": {
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
