{
  "name": "@aethelred/wallet-credentials",
  "version": "0.1.0",
  "private": true,
  "description": "Regulatory Passport as Verifiable Credentials: EAS-style attestations for KYC, jurisdiction, accredited-investor, VASP license, and sanctions-clear, with selective disclosure and ZK-friendly presentation primitives.",
  "keywords": [
    "wallet",
    "credentials",
    "verifiable-credentials",
    "vc",
    "eas",
    "attestation",
    "kyc",
    "aml",
    "vasp",
    "sanctions",
    "zk",
    "zero-knowledge",
    "selective-disclosure",
    "regulatory-passport",
    "web3"
  ],
  "author": "Aethelred Foundation",
  "//license": "License under review; target is MIT or Apache-2.0 once the SDK is extracted from the private monorepo.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/aethelred-foundation/wallet.git",
    "directory": "packages/credentials"
  },
  "homepage": "https://github.com/aethelred-foundation/wallet/tree/main/packages/credentials#readme",
  "bugs": {
    "url": "https://github.com/aethelred-foundation/wallet/issues"
  },
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./types": {
      "types": "./src/types.ts",
      "import": "./src/types.ts",
      "default": "./src/types.ts"
    },
    "./payloads": {
      "types": "./src/payloads.ts",
      "import": "./src/payloads.ts",
      "default": "./src/payloads.ts"
    },
    "./issuers": {
      "types": "./src/issuer-registry.ts",
      "import": "./src/issuer-registry.ts",
      "default": "./src/issuer-registry.ts"
    },
    "./manager": {
      "types": "./src/credential-manager.ts",
      "import": "./src/credential-manager.ts",
      "default": "./src/credential-manager.ts"
    },
    "./verifier": {
      "types": "./src/verifier.ts",
      "import": "./src/verifier.ts",
      "default": "./src/verifier.ts"
    }
  },
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@aethelred/wallet-audit": "file:../audit",
    "@aethelred/wallet-observability": "file:../observability",
    "@noble/secp256k1": "^2.2.3",
    "@noble/hashes": "^2.2.0"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  }
}
