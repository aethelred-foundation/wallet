{
  "name": "@aethelred/wallet-local",
  "version": "0.1.0",
  "private": true,
  "description": "Local workspace for Aethelred Wallet execution",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:extension": "npm run dev -w @aethelred/wallet-extension",
    "build:extension": "npm run build -w @aethelred/wallet-extension",
    "preview:extension": "npm run preview -w @aethelred/wallet-extension",
    "type-check": "npm run type-check --workspaces --if-present",
    "bench": "vitest bench --run --config vitest.bench.config.mts",
    "size": "npm run size -w @aethelred/wallet-extension",
    "size:why": "npm run size:why -w @aethelred/wallet-extension",
    "lighthouse": "npm run lighthouse -w @aethelred/wallet-extension",
    "bundle:analyze": "npm run bundle:analyze -w @aethelred/wallet-extension",
    "test:e2e": "cd apps/extension && npx playwright test --config=e2e/playwright.config.ts",
    "test:property": "cd apps/extension && npx vitest run property",
    "test:fuzz": "cd apps/extension && npx vitest run fuzz",
    "test:a11y": "cd apps/extension && npx vitest run a11y",
    "test:contract": "cd apps/extension && npx vitest run contract",
    "test:coverage": "cd apps/extension && npx vitest run --coverage",
    "test:coverage:ci": "cd apps/extension && npx vitest run --coverage --reporter=default --reporter=json --outputFile=coverage/ci-report.json",
    "audit:coverage": "node scripts/coverage-audit.mjs",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "storybook:test": "test-storybook",
    "mutation:test": "stryker run",
    "package:extension": "node scripts/package-extension.mjs",
    "optimize:images": "node scripts/optimize-images.mjs",
    "bundle:manifest": "node scripts/generate-bundle-manifest.mjs",
    "bundle:compare": "node scripts/compare-bundle.mjs",
    "bundle:comment": "node scripts/post-bundle-comment.mjs",
    "bundle:diff": "node scripts/bundle-diff.mjs",
    "bundle:baseline:update": "node scripts/generate-bundle-manifest.mjs && node -e \"require('node:fs').copyFileSync('apps/extension/dist/_bundle-manifest.json', 'reports/bundle-baseline.json')\"",
    "demo": "npm run demo -w @aethelred/wallet-integration",
    "demo:json": "npm run demo -w @aethelred/wallet-integration -- --json",
    "demo:quiet": "npm run demo -w @aethelred/wallet-integration -- --quiet",
    "demo:solvers": "npm run demo:solvers -w @aethelred/wallet-integration --",
    "demo:solvers:json": "npm run demo:solvers -w @aethelred/wallet-integration -- --json",
    "demo:solvers:quiet": "npm run demo:solvers -w @aethelred/wallet-integration -- --quiet",
    "demo:solvers:deny": "npm run demo:solvers -w @aethelred/wallet-integration -- --deny",
    "demo:solvers:deny:json": "npm run demo:solvers -w @aethelred/wallet-integration -- --deny --json",
    "demo:solvers:deny:quiet": "npm run demo:solvers -w @aethelred/wallet-integration -- --deny --quiet",
    "demo:solvers:prom": "npm run demo:solvers -w @aethelred/wallet-integration -- --prom",
    "demo:solvers:html": "npm run demo:solvers -w @aethelred/wallet-integration -- --html",
    "demo:solvers:v3": "npm run demo:solvers -w @aethelred/wallet-integration -- --venue uniswap-v3",
    "gas:check": "cd contracts && node scripts/check-gas-budgets.mjs",
    "gas:measure": "cd contracts && node scripts/check-gas-budgets.mjs --measure-only",
    "gas:snapshot": "cd contracts && forge snapshot",
    "gas:snapshot:check": "cd contracts && forge snapshot --check",
    "lint:dead-code": "node scripts/check-dead-exports.mjs",
    "lint:dead-code:update": "node scripts/check-dead-exports.mjs --update",
    "lint:circular": "madge --circular --warning --extensions ts,tsx apps/extension/src packages",
    "lint:circular:workspaces": "node scripts/check-workspace-deps.mjs",
    "lint:bundle-weight": "node scripts/report-bundle-weight.mjs",
    "lint:dep-freshness": "node scripts/report-dep-freshness.mjs",
    "code-health": "npm run lint:dead-code && npm run lint:circular && npm run lint:circular:workspaces",
    "prepare": "husky || true"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "madge": "^8.0.0",
    "sharp": "^0.34.5",
    "ts-unused-exports": "^11.0.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  }
}
