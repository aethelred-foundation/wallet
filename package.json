{
  "name": "@aethelred/wallet-local",
  "version": "0.1.0",
  "private": true,
  "description": "Local workspace for Aethelred Wallet execution",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:extension": "pnpm --filter @aethelred/wallet-extension run dev",
    "build:extension": "pnpm --filter @aethelred/wallet-extension run build",
    "preview:extension": "pnpm --filter @aethelred/wallet-extension run preview",
    "type-check": "pnpm -r run type-check",
    "bench": "vitest bench --run --config vitest.bench.config.mts",
    "size": "pnpm --filter @aethelred/wallet-extension run size",
    "size:why": "pnpm --filter @aethelred/wallet-extension run size:why",
    "lighthouse": "pnpm --filter @aethelred/wallet-extension run lighthouse",
    "bundle:analyze": "pnpm --filter @aethelred/wallet-extension run bundle:analyze",
    "test:e2e": "cd apps/extension && npx playwright test --config=e2e/playwright.config.ts",
    "test:property": "cd apps/extension && npx vitest run property",
    "test:fuzz": "cd apps/extension && npx vitest run fuzz",
    "test:a11y": "cd apps/extension && npx vitest run a11y",
    "test:contract": "cd apps/extension && npx vitest run contract",
    "test:chain-cosmos": "vitest run --config vitest.chain-cosmos.config.mts --coverage",
    "test:coverage": "cd apps/extension && npx vitest run --coverage",
    "test:coverage:ci": "cd apps/extension && npx vitest run --coverage --reporter=default --reporter=json --outputFile=coverage/ci-report.json",
    "audit:coverage": "node scripts/coverage-audit.mjs",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "storybook:test": "test-storybook",
    "mutation:test": "stryker run",
    "package:extension": "node scripts/package-extension.mjs",
    "optimize:images": "node scripts/optimize-images.mjs",
    "bundle:manifest": "node scripts/generate-bundle-manifest.mjs",
    "bundle:compare": "node scripts/compare-bundle.mjs",
    "bundle:comment": "node scripts/post-bundle-comment.mjs",
    "bundle:diff": "node scripts/bundle-diff.mjs",
    "bundle:baseline:update": "node scripts/generate-bundle-manifest.mjs && node -e \"require('node:fs').copyFileSync('apps/extension/dist/_bundle-manifest.json', 'reports/bundle-baseline.json')\"",
    "demo": "pnpm --filter @aethelred/wallet-integration run demo",
    "demo:json": "pnpm --filter @aethelred/wallet-integration run demo -- --json",
    "demo:quiet": "pnpm --filter @aethelred/wallet-integration run demo -- --quiet",
    "demo:solvers": "pnpm --filter @aethelred/wallet-integration run demo:solvers --",
    "demo:solvers:json": "pnpm --filter @aethelred/wallet-integration run demo:solvers -- --json",
    "demo:solvers:quiet": "pnpm --filter @aethelred/wallet-integration run demo:solvers -- --quiet",
    "demo:solvers:deny": "pnpm --filter @aethelred/wallet-integration run demo:solvers -- --deny",
    "demo:solvers:deny:json": "pnpm --filter @aethelred/wallet-integration run demo:solvers -- --deny --json",
    "demo:solvers:deny:quiet": "pnpm --filter @aethelred/wallet-integration run demo:solvers -- --deny --quiet",
    "demo:solvers:prom": "pnpm --filter @aethelred/wallet-integration run demo:solvers -- --prom",
    "demo:solvers:html": "pnpm --filter @aethelred/wallet-integration run demo:solvers -- --html",
    "demo:solvers:v3": "pnpm --filter @aethelred/wallet-integration run demo:solvers -- --venue uniswap-v3",
    "gas:check": "cd contracts && node scripts/check-gas-budgets.mjs",
    "gas:measure": "cd contracts && node scripts/check-gas-budgets.mjs --measure-only",
    "gas:snapshot": "cd contracts && forge snapshot",
    "gas:snapshot:check": "cd contracts && forge snapshot --check",
    "lint:dead-code": "knip --production --include exports,nsExports,types,nsTypes,enumMembers,namespaceMembers --no-progress --no-tag-hints",
    "lint:circular": "madge --circular --warning --extensions ts,tsx apps/extension/src packages",
    "lint:circular:workspaces": "node scripts/check-workspace-deps.mjs",
    "lint:bundle-weight": "node scripts/report-bundle-weight.mjs",
    "lint:dep-freshness": "node scripts/report-dep-freshness.mjs",
    "code-health": "pnpm run lint:dead-code && pnpm run lint:circular && pnpm run lint:circular:workspaces && pnpm run lint:bundle-weight",
    "prepare": "husky || true"
  },
  "engines": {
    "node": ">=24.18.0",
    "pnpm": ">=11.9.0"
  },
  "packageManager": "pnpm@11.9.0",
  "devDependencies": {
    "husky": "^9.1.7",
    "knip": "6.27.0",
    "madge": "^8.0.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "sharp": "^0.34.5"
  }
}
