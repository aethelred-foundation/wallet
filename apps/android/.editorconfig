# EditorConfig — https://editorconfig.org
#
# Applies to every file in the Android module. The Kotlin-specific
# section enforces the style used across the wallet codebase so IDE
# defaults don't quietly reformat the module on someone else's machine.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
indent_size = 4
ij_continuation_indent_size = 4
ij_kotlin_imports_layout = *
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true

[*.{xml,gradle.kts}]
indent_size = 4

[*.{json,yml,yaml,toml}]
indent_size = 2

[Makefile]
indent_style = tab
