<?xml version="1.0" encoding="utf-8"?>
<!--
  Aethelred Wallet — UI string catalogue.

  Every user-facing string in the wallet belongs here. The Lint
  HardcodedText rule (enabled in app/build.gradle.kts) enforces this
  at compile time so we stay translation-ready.

  Tokens marked with [brand] must NOT be localised; they are proper
  nouns or addresses that stay English.
-->
