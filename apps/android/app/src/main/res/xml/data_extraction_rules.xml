<?xml version="1.0" encoding="utf-8"?>
<!--
  Aethelred Wallet — Android 12+ data extraction rules.

  Covers both cloud backups (to Google Drive) and device-to-device
  transfer (setup wizard). Both flows are blanket-denied.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
