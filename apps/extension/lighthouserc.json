{
  "//": "Lighthouse CI configuration for the Aethelred Wallet extension. Chrome extension pages (popup.html, options.html) are not PWAs and are never indexed by search engines. The default `lhci autorun` preset treats them as websites and asserts against structurally inapplicable audits (PWA installability, splash-screen, maskable icons, themed-omnibox, meta-description, content-width — our popup is fixed 400x600 and intentionally not responsive). This config scopes the run to the audits that genuinely matter for extension quality — performance, accessibility, best-practices — with thresholds tuned to the reality of a bundled popup served by lhci's local static dir. Skipped audits are documented inline via per-key 'off' assertions and `skipAudits`.",
  "ci": {
    "collect": {
      "url": [
        "http://localhost/popup.html",
        "http://localhost/options.html"
      ],
      "staticDistDir": "./dist",
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop",
        "formFactor": "desktop",
        "onlyCategories": [
          "performance",
          "accessibility",
          "best-practices"
        ],
        "skipAudits": [
          "installable-manifest",
          "maskable-icon",
          "splash-screen",
          "themed-omnibox",
          "apple-touch-icon",
          "meta-description",
          "content-width",
          "csp-xss",
          "server-response-time",
          "non-composited-animations",
          "unused-javascript"
        ],
        "screenEmulation": {
          "mobile": false,
          "width": 400,
          "height": 600,
          "deviceScaleFactor": 1,
          "disabled": false
        },
        "throttling": {
          "rttMs": 40,
          "throughputKbps": 10240,
          "cpuSlowdownMultiplier": 1,
          "requestLatencyMs": 0,
          "downloadThroughputKbps": 0,
          "uploadThroughputKbps": 0
        }
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "warn",
          { "minScore": 0.75 }
        ],
        "categories:accessibility": [
          "error",
          { "minScore": 0.90 }
        ],
        "categories:best-practices": [
          "error",
          { "minScore": 0.90 }
        ],
        "color-contrast": [
          "warn",
          { "minScore": 0.95 }
        ],
        "errors-in-console": [
          "warn",
          { "minScore": 0.9 }
        ],
        "total-byte-weight": [
          "warn",
          { "maxNumericValue": 800000 }
        ],
        "first-contentful-paint": [
          "warn",
          { "maxNumericValue": 3000 }
        ],
        "largest-contentful-paint": [
          "warn",
          { "maxNumericValue": 4000 }
        ],
        "interactive": [
          "warn",
          { "maxNumericValue": 5000 }
        ],
        "cumulative-layout-shift": [
          "error",
          { "maxNumericValue": 0.1 }
        ],
        "total-blocking-time": [
          "warn",
          { "maxNumericValue": 600 }
        ],
        "render-blocking-resources": "off",
        "speed-index": "off",
        "first-meaningful-paint": "off",
        "bootup-time": "off",
        "mainthread-work-breakdown": "off",
        "dom-size": "off",
        "uses-long-cache-ttl": "off"
      }
    }
  }
}
