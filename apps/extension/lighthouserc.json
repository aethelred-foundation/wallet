{
  "//": "Blocking Lighthouse CI configuration for the Aethelred Wallet extension. Every active assertion is severity=error. Thresholds include CI-runner headroom from the 2026-07-25 final six-run baseline: popup performance 0.98-0.99, accessibility/best-practices/console 1.00, FCP <=689ms, LCP <=805ms, interactive <=689ms, TBT=0ms, CLS=0, transfer <=256KB; options was faster/smaller. Chrome extension pages are not PWAs or indexed websites, so only structurally inapplicable, redundant, or non-gating website audits remain skipped/off.",
  "ci": {
    "collect": {
      "url": [
        "http://localhost/popup.html",
        "http://localhost/options.html"
      ],
      "staticDistDir": "./dist",
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop",
        "formFactor": "desktop",
        "onlyCategories": [
          "performance",
          "accessibility",
          "best-practices"
        ],
        "skipAudits": [
          "installable-manifest",
          "maskable-icon",
          "splash-screen",
          "themed-omnibox",
          "apple-touch-icon",
          "meta-description",
          "content-width",
          "csp-xss",
          "server-response-time",
          "non-composited-animations",
          "unused-javascript"
        ],
        "screenEmulation": {
          "mobile": false,
          "width": 400,
          "height": 600,
          "deviceScaleFactor": 1,
          "disabled": false
        },
        "throttling": {
          "rttMs": 40,
          "throughputKbps": 10240,
          "cpuSlowdownMultiplier": 1,
          "requestLatencyMs": 0,
          "downloadThroughputKbps": 0,
          "uploadThroughputKbps": 0
        }
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          { "minScore": 0.9 }
        ],
        "categories:accessibility": [
          "error",
          { "minScore": 0.95 }
        ],
        "categories:best-practices": [
          "error",
          { "minScore": 0.9 }
        ],
        "color-contrast": [
          "error",
          { "minScore": 1 }
        ],
        "errors-in-console": [
          "error",
          { "minScore": 1 }
        ],
        "total-byte-weight": [
          "error",
          { "maxNumericValue": 300000 }
        ],
        "first-contentful-paint": [
          "error",
          { "maxNumericValue": 1500 }
        ],
        "largest-contentful-paint": [
          "error",
          { "maxNumericValue": 2000 }
        ],
        "interactive": [
          "error",
          { "maxNumericValue": 2500 }
        ],
        "cumulative-layout-shift": [
          "error",
          { "maxNumericValue": 0.05 }
        ],
        "total-blocking-time": [
          "error",
          { "maxNumericValue": 300 }
        ],
        "render-blocking-resources": "off",
        "speed-index": "off",
        "first-meaningful-paint": "off",
        "bootup-time": "off",
        "mainthread-work-breakdown": "off",
        "dom-size": "off",
        "uses-long-cache-ttl": "off"
      }
    }
  }
}
