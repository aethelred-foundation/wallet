{
  "//": "Workspace-wide tsconfig for `ts-unused-exports`. Aggregates every source tree so a reference in apps/extension to `@aethelred/wallet-chain/Foo` counts as a consumer of the export from packages/chain/src/... — otherwise per-package scans would incorrectly flag everything as unused.",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "types": ["vite/client", "node", "chrome"]
  },
  "include": [
    "apps/extension/src",
    "apps/extension/vite.config.ts",
    "packages/approval/src",
    "packages/audit/src",
    "packages/chain/src",
    "packages/chain-btc/src",
    "packages/chain-solana/src",
    "packages/compliance/src",
    "packages/connect/src",
    "packages/core/src",
    "packages/credentials/src",
    "packages/deployment/src",
    "packages/identity/src",
    "packages/observability/src",
    "packages/policy/src",
    "packages/simulation/src",
    "packages/smart-account/src"
  ],
  "exclude": [
    "apps/extension/e2e",
    "apps/extension/src/popup/components/stories",
    "**/*.stories.ts",
    "**/*.stories.tsx",
    "**/node_modules",
    "**/dist"
  ]
}
